  "$id": "https://github.com/thedhinakarr/ephorate/blob/main/docs/report-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Cross-reference existence, stable ordering, finite timing values and verdict evidence invariants are additionally enforced by report contract tests.",
  "properties": {
    "baseline": {
      "additionalProperties": false,
      "properties": {
        "excluded": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "node_id": {
                "type": "string"
              },
              "outcome": {
                "$ref": "#/$defs/Outcome"
              }
            },
            "required": [
              "node_id",
              "outcome"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "passing": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "trial_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "trial_ids",
        "passing",
        "excluded"
      ],
      "type": "object"
    },
    "change": {
      "additionalProperties": false,
      "properties": {
        "base_sha": {
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
          "type": "string"
        },
        "base_tree": {
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
          "type": "string"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/FileChange"
          },
          "type": "array"
        },
        "head_sha": {
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
          "type": "string"
        },
        "head_tree": {
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
          "type": "string"
        }
      },
      "required": [
        "base_sha",
        "head_sha",
        "base_tree",
        "head_tree",
        "files"
      ],
      "type": "object"
    },
    "config": {
      "additionalProperties": false,
      "properties": {
        "baseline_timeout_seconds": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "budget_seconds": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "command_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "effective_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "fail_on": {
          "items": {
            "enum": [
              "loose",
              "unjudged",
              "idle"
            ]
          },
          "type": "array",
          "uniqueItems": true
        },
        "invocation": {
          "const": [
            "<python>",
            "-m",
            "pytest"
          ]
        },
        "judge_patterns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "max_units": {
          "minimum": 1,
          "type": "integer"
        },
        "min_trial_timeout_seconds": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "other_patterns": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "source_root": {
          "enum": [
            ".",
            "src"
          ]
        },
        "timeout_factor": {
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "source_root",
        "judge_patterns",
        "other_patterns",
        "max_units",
        "budget_seconds",
        "baseline_timeout_seconds",
        "min_trial_timeout_seconds",
        "timeout_factor",
        "fail_on",
        "invocation",
        "command_sha256",
        "effective_config_sha256"
      ],
      "type": "object"
    },
    "counts": {
      "additionalProperties": false,
      "properties": {
        "subject_lines": {
          "additionalProperties": false,
          "properties": {
            "held": {
              "minimum": 0,
              "type": "integer"
            },
            "inert": {
              "minimum": 0,
              "type": "integer"
            },
            "loose": {
              "minimum": 0,
              "type": "integer"
            },
            "unjudged": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "held",
            "loose",
            "inert",
            "unjudged"
          ],
          "type": "object"
        },
        "units": {
          "additionalProperties": false,
          "properties": {
            "held": {
              "minimum": 0,
              "type": "integer"
            },
            "inert": {
              "minimum": 0,
              "type": "integer"
            },
            "loose": {
              "minimum": 0,
              "type": "integer"
            },
            "unjudged": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "held",
            "loose",
            "inert",
            "unjudged"
          ],
          "type": "object"
        },
        "unknown_line_unit_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "units",
        "subject_lines",
        "unknown_line_unit_ids"
      ],
      "type": "object"
    },
    "environment": {
      "additionalProperties": false,
      "properties": {
        "git_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "implementation": {
          "const": "cpython"
        },
        "platform": {
          "enum": [
            "linux",
            "macos"
          ]
        },
        "plugins": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "name",
                  "version"
                ],
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "pytest_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "python_version": {
          "type": "string"
        }
      },
      "required": [
        "python_version",
        "implementation",
        "platform",
        "git_version",
        "pytest_version",
        "plugins"
      ],
      "type": "object"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/GroupResult"
      },
      "type": "array"
    },
    "idle_tests": {
      "items": {
        "$ref": "#/$defs/IdleResult"
      },
      "type": "array"
    },
    "reading_list": {
      "additionalProperties": false,
      "properties": {
        "group_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "idle_node_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "judge_paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unit_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "unit_ids",
        "group_ids",
        "idle_node_ids",
        "judge_paths"
      ],
      "type": "object"
    },
    "reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/Reason"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "timings": {
      "additionalProperties": false,
      "properties": {
        "total_s": {
          "minimum": 0,
          "type": "number"
        },
        "trials": {
          "additionalProperties": {
            "minimum": 0,
            "type": "number"
          },
          "type": "object"
        }
      },
      "required": [
        "total_s",
        "trials"
      ],
      "type": "object"
    },
    "tool": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "ephorate"
        },
        "version": {
          "const": "0.1.0a1"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "trials": {
      "items": {
        "$ref": "#/$defs/TrialResult"
      },
      "type": "array"
    },
    "units": {
      "items": {
        "$ref": "#/$defs/UnitResult"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "tool",
    "environment",
    "change",
    "config",
    "status",
    "reason",
    "baseline",
    "units",
    "trials",
    "groups",
    "idle_tests",
    "reading_list",
    "counts",
    "timings"
  ],
  "title": "Ephorate report version 1",
  "type": "object"
}
